generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?  @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("criado_em")
}

model Aluno {
  id           String        @id @default(cuid())
  nome         String        @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  certificados Certificado[]
}

model Certificado {
  id                String   @id @default(cuid())
  alunoId           String   @map("aluno_id") @db.VarChar(255)
  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  codigoVerificacao String   @unique @map("codigo_verificacao") @db.VarChar(255)
  nomeCurso         String   @map("nome_curso") @db.VarChar(255)
  nomeInstrutor     String   @map("nome_instrutor") @db.VarChar(255)
  cargaHoraria      Int      @map("carga_horaria")
  dataConclusao     DateTime @map("data_conclusao")
  ativo             Boolean  @default(true)
  origem            String   @db.VarChar(50) // "automatico" ou "manual"
  criadoEm          DateTime @default(now()) @map("criado_em")

  @@index([codigoVerificacao])
  @@index([alunoId])
}
